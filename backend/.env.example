NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Configure all three values for real Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_COOKIE_NAME=reachinbox_session
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
SESSION_COOKIE_SECURE=false

# Use localhost when the backend runs directly on the host.
POSTGRES_DB=reachinbox
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_dev_password
DATABASE_URL=postgresql://reachinbox:reachinbox_dev_password@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
EMAIL_SEND_DELAY_MS=2000
# Must exceed the longest expected pre-SMTP wait or SMTP operation.
PROCESSING_LEASE_MS=300000

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_RECONCILIATION_INTERVAL_MS=60000

ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_SECURE=false

# When the backend runs in Docker Compose, use these service hostnames instead:
# DATABASE_URL=postgresql://reachinbox:reachinbox_dev_password@postgres:5432/reachinbox
# REDIS_URL=redis://redis:6379
# ELASTICSEARCH_URL=http://elasticsearch:9200
